# docker-compose default values.
# Copy this file to `.env` at the repo root and adjust as needed. Compose reads
# `.env` automatically for variable substitution and injects the backend env.
#
#   cp .env.example .env && docker compose up --build
#
# The backend container is given a fixed DATABASE_URL/REDIS_URL that point at
# the Compose-managed postgres/redis services. Override secrets below.

# Secrets for the backend (also used as JWT_COOKIE secrets)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# CORS allow-lists
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001,http://localhost:3000
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:3000

# Image name/owner used by `image:` (and the GHCR CI workflow)
IMAGE_OWNER=your-org
IMAGE_TAG=local
